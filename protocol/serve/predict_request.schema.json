{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spikeforge.dev/protocol/1.0/serve/predict_request.schema.json",
  "title": "PredictRequest",
  "description": "The POST /v1/predict body: a non-empty list of raw samples or pre-encoded frames.",
  "type": "object",
  "properties": {
    "frames": {
      "type": "array",
      "items": {},
      "minItems": 1
    },
    "encoded": { "type": "boolean", "default": false },
    "session_id": { "type": ["string", "null"], "default": null }
  },
  "required": ["frames"],
  "additionalProperties": true
}
