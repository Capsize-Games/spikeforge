{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spikeforge.dev/protocol/1.0/serve/stream_message.schema.json",
  "title": "StreamMessage",
  "description": "One reply from WS /v1/stream: a discriminator and its payload.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["prediction", "reset", "session", "error"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": true
}
